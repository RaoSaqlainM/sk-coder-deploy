# Frontend Environment Variables (sk-coder-web/.env)
VITE_API_URL=http://localhost:3001
VITE_GITHUB_CLIENT_ID=your-github-client-id-here
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/github

# Backend Environment Variables (api-server/.env)
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Code Execution Services
PISTON_API_URL=https://emkc.org/api/v2
WANDBOX_API_URL=https://wandbox.org/api
BACKEND_EXEC_ENABLED=true

# Storage Configuration
ORACLE_STORAGE_PATH=/mnt/storage
MAX_FILE_SIZE=52428800
MAX_EXECUTION_TIME=30000
CLEANUP_INTERVAL=259200000

# Optional: External AI APIs (user can provide their own)
OPENAI_API_KEY=sk-your-key-here
GOOGLE_GEMINI_KEY=your-gemini-key-here

# Deployment (Vercel/Cloud)
VERCEL=false
VERCEL_ENV=development
VERCEL_URL=http://localhost:5173
